{
  "name": "lensdesk",
  "version": "0.2.0",
  "private": true,
  "description": "LensDesk: contenedor de escritorio modular y 100% local para herramientas de desarrollo",
  "license": "MIT",
  "author": "LensSystems",
  "homepage": "https://github.com/LensSystems/LensDesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LensSystems/LensDesk.git"
  },
  "bugs": {
    "url": "https://github.com/LensSystems/LensDesk/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "lensdesk": {
    "releasesRepo": "LensSystems/LensDesk"
  },
  "scripts": {
    "dev": "pnpm --filter @lensdesk/desktop dev",
    "build": "pnpm --filter @lensdesk/desktop build",
    "smoke": "pnpm build && node scripts/smoke-check.ts",
    "icons": "node scripts/build-icons.ts",
    "screenshots": "node scripts/screenshots.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=app",
    "test:e2e:packaged": "playwright test --project=packaged",
    "lenspkg": "node packages/lenspkg/src/cli.ts",
    "tools:package": "pnpm --filter \"./tools/*\" run package",
    "dist": "pnpm --filter @lensdesk/desktop dist",
    "dist:dir": "pnpm --filter @lensdesk/desktop dist:dir",
    "ui:gallery": "vite --config packages/ui/gallery/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "electron": "44.7.1",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
